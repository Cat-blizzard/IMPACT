# Runtime-only ArduPilot SITL defaults for IMPACT Gate P4.
AHRS_EKF_TYPE 3
EK2_ENABLE 0
EK3_ENABLE 1
EK3_SRC1_POSXY 6
EK3_SRC1_VELXY 6
EK3_SRC1_POSZ 6
EK3_SRC1_VELZ 6
EK3_SRC1_YAW 6
VISO_TYPE 2
# ArduPilot 4.6+ names the two receiver parameters GPS1_TYPE/GPS2_TYPE.
# The legacy GPS_TYPE/GPS_TYPE2 names are no longer exposed by current SITL.
GPS1_TYPE 0
GPS2_TYPE 0
# Preserve pre-arm IMU and VisualOdom evidence. This changes logging only.
LOG_DISARMED 1
